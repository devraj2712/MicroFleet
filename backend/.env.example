# MicroFleet Backend Environment Configuration (Template)
# Copy this file to .env and populate with local values. Do NOT commit .env to source control.

PROJECT_NAME="MicroFleet Intelligent Logistics"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Persistence
DATABASE_URL="sqlite:///./microfleet.db"

# Security & Firebase Authentication
FIREBASE_PROJECT_ID="microfleet-demo"
FIREBASE_CREDENTIALS_PATH=""

# Geospatial & OSMnx
OSM_NETWORK_PATH="data/networks/city_drive_network.graphml"
DEFAULT_CITY_BBOX="[18.55, 18.48, 73.88, 73.80]" # Example: Urban District Bounding Box

# Intelligence Engine Hyperparameters
DISPATCH_INTERVAL_SECONDS=60
MAX_BATCH_SIZE_ORDERS=8
ACO_NUM_ANTS=20
ACO_MAX_ITERATIONS=50
GA_POPULATION_SIZE=50
GA_GENERATIONS=60
RL_MODEL_PATH="models/rl_dispatch_agent.zip"
